# Where the Railway API lives, and the token it expects (server-side only).
DIA_API_URL=http://127.0.0.1:8077
DIA_API_TOKEN=dev-token

# Team sign-in. Comma-separated allowlist of emails, one shared access code,
# and a random 32+ char secret for signing session cookies.
DIA_ALLOWED_EMAILS=shaw@bconz.com
DIA_ACCESS_CODE=change-me
SESSION_SECRET=replace-with-32-plus-random-characters
